# Kaizen Supabase (created in Stage C-1.1) -----------------
NEXT_PUBLIC_KAIZEN_SUPABASE_URL=
NEXT_PUBLIC_KAIZEN_SUPABASE_ANON_KEY=
KAIZEN_SUPABASE_URL=
KAIZEN_SUPABASE_SERVICE_ROLE_KEY=

# Hudson One bridge (provided by HW maintainer in Stage C-1.5)
# DO NOT use the universal HW service-role key here. Provision a NEW key
# scoped only to: case_assets, case_liabilities, case_charges,
# kaizen_bridge_check_access RPC.
HUDSON_ONE_SUPABASE_URL=
HUDSON_ONE_SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for signing bridge responses (32+ chars, generated locally)
BRIDGE_HMAC_SECRET=

# Set to "1" to skip env validation in CI / lint-only jobs
SKIP_ENV_VALIDATION=
